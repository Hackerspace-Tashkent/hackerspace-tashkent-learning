# ---------------------------------------------------------------------------
# Hackerspace Tashkent — учебный репозиторий
#
# Порядок разделов: секреты, язык, инструменты, ОС, редакторы, артефакты.
# Если сомневаешься, что игнорировать, — не игнорируй. Лишний файл в
# истории лучше, чем потерянная работа или утёкший ключ.
# ---------------------------------------------------------------------------

# ============================== СЕКРЕТЫ ==============================
# Правило номер один: ключи и токены не попадают в репозиторий.
# Как ДОЛЖНО выглядеть, показывает .env.example.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*.token
*.secret
.netrc

# ============================== PYTHON ===============================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.conda/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
.eggs/
build/
dist/

# ============================= JUPYTER ==============================
.ipynb_checkpoints/

# ============================= ИНСТРУМЕНТЫ ===========================
tmp/
temp/
.cache/
*.log
*.bak
*.orig
*.rej
*.swp
*~

# ================================ ОС =================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ============================ РЕДАКТОРЫ =============================
.vscode/
!.vscode/extensions.json
.idea/
*.iml
.fleet/
.zed/
nvim.log

# ========================= УЧЕБНАЯ ПРАКТИКА =========================
# То, что ученик делает сам, в историю не попадает
labs/**/lab-work/
labs/**/solution/
labs/**/.lab-data/
