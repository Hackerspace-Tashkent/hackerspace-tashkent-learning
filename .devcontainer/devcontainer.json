{
  "name": "Hackerspace Tashkent — Learning",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "shutdownAction": "stopContainer",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
